# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会提交。
# ============================================================

# ---------- LLM 通道 ----------
# 混合路由模式：local | cloud | hybrid
LLM_MODE=hybrid
# 云端调用失败时是否自动降级到本地 Ollama
LLM_FALLBACK_TO_LOCAL=true

# 本地兜底通道（Ollama）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# 云端提效通道（阿里云百炼 / 通义千问，OpenAI 兼容接口）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ---------- 外部服务地址 ----------
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 既有漫剧执行服务（E:\aigc-comic），只读调用
AIGC_COMIC_BASE_URL=http://127.0.0.1:8000

# ---------- 本地路径 ----------
PROJECT_ROOT=E:/interview-demo
MODELS_DIR=E:/interview-demo/models
CORPUS_DIR=E:/interview-demo/data/corpus
INDEX_DIR=E:/interview-demo/data/index
OUTPUT_DIR=E:/interview-demo/outputs

# ---------- 既有资产（只读复用，禁止修改） ----------
AIGC_COMIC_HOME=E:/aigc-comic
HUMANIZE_CHINESE_HOME=E:/ai-tools/humanize-chinese
CNKI_AIGC_HOME=E:/ai-tools/cnki-aigc---skill
COMFYUI_HOME=D:/ComfyUI
GPT_SOVITS_HOME=D:/AI/GPT-SoVITS

# ---------- 显存调度（8 GB 约束） ----------
# true：检测 / 语音 / 问答 阶段式加载，不同时驻留
VRAM_STAGED_LOADING=true
