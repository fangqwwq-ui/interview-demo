.venv/
__pycache__/
*.pyc
*.pyo
.env

# 大文件与产物不入库，仅保留占位
models/*
!models/.gitkeep
outputs/*
!outputs/.gitkeep
data/corpus/*
!data/corpus/.gitkeep
data/index/*
!data/index/.gitkeep
demo_c_manju/outputs/*
!demo_c_manju/outputs/.gitkeep
# Demo B 语料分两层，入库策略必须区别对待：
#   raw/   —— 人工撰写的源数据，是整个 Demo 的输入。**必须入库**，
#            否则 clone 下来无法复现，与「可复现」的前提直接冲突。
#   clean/ —— ingest.py 的确定性产物（同输入必得同输出），可由一条命令重建，
#            因此不入库，避免"两份真相"。
demo_b_copywriting/data/clean/*
!demo_b_copywriting/data/clean/.gitkeep

# 排序索引：由 build_index.py 重建，且与编码器强绑定，不入库
demo_b_copywriting/data/index/*
!demo_b_copywriting/data/index/.gitkeep

# Demo A 同理，区分「源数据」与「确定性产物」：
#   eval_set.jsonl —— 人工撰写的评测集，是整个准确率指标的输入。**必须入库**，
#                    否则 a_rag_accuracy 无法在clone 后复现。
#   data/demo_a/index/ —— 由 rag.build() 从工单库确定性重建（FAISS 索引 +
#                    meta），且与编码器强绑定，不入库以避免"两份真相"。
data/demo_a/index/*
!data/demo_a/index/.gitkeep

# 引入的第三方组件不带其 git 历史
third_party/humanize-chinese/.git/
